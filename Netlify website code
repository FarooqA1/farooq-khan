<style>
:root{--bg:#F6F3EC;--ink:#0F1B2D;--dk:#0F1B2D;--dkink:#F6F3EC;--brass:#B8864B;--line:rgba(15,27,45,.2);--mut:#3d4a5c;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0F1B2D;--ink:#F6F3EC;--dk:#08111e;--line:rgba(246,243,236,.22);--mut:#c9ccd2;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0F1B2D;--ink:#F6F3EC;--dk:#08111e;--line:rgba(246,243,236,.22);--mut:#c9ccd2;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
:root{
  --paper:#FAF8F3;--paper-2:#F1EDE3;--ink:#15171C;--ink-2:#4A4F5C;
  --blue:#1B2FB8;--blue-d:#121F80;--blue-l:#E7EAFB;--sun:#FFC93C;--sun-d:#E8AE12;
  --line:rgba(21,23,28,.12);--r:14px;
  --display:"Bricolage Grotesque",Georgia,sans-serif;--body:"Hanken Grotesk",system-ui,sans-serif;--mono:"JetBrains Mono",ui-monospace,monospace;
}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 "DM Sans",system-ui,sans-serif}
h1,h2,h3{font-family:Fraunces,Georgia,serif;font-weight:400;line-height:1.12;margin:0}
h1{font-size:clamp(2.4rem,9vw,4.6rem);letter-spacing:-.015em}
h2{font-size:clamp(1.9rem,6vw,3rem);letter-spacing:-.01em;margin-bottom:1.5rem}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--paper);color:var(--ink);font:400 1.0625rem/1.6 var(--body);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--display);font-weight:700;line-height:1.02;margin:0;letter-spacing:-.025em}
h1{font-size:clamp(2.7rem,7.4vw,5.6rem);font-weight:800}
h2{font-size:clamp(2rem,5vw,3.4rem)}
h3{font-size:1.45rem;letter-spacing:-.015em}
p{margin:0 0 1rem}
.w{max-width:1040px;margin:0 auto;padding:0 1.25rem}
section{padding:4.5rem 0}
.dark{background:var(--dk);color:var(--dkink)}
.eyebrow{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;font-weight:500;margin-bottom:1rem;opacity:.75}
.btn{display:inline-block;background:var(--brass);color:#0F1B2D;font:500 1.05rem "DM Sans",sans-serif;padding:1rem 1.6rem;border:0;border-radius:2px;text-decoration:none;cursor:pointer;min-height:52px;transition:background .2s,transform .2s}
.btn:hover,.btn:focus-visible{background:#c9985c;transform:translateY(-1px)}
a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid var(--brass);outline-offset:3px}
header .w{display:flex;justify-content:space-between;align-items:center;padding-top:1.1rem;padding-bottom:1.1rem;border-bottom:1px solid var(--line)}
.logo{font-family:Fraunces,serif;font-size:1.25rem}
header .btn{padding:.6rem 1rem;min-height:44px;font-size:.95rem}
.hero{padding:4rem 0 4.5rem}
.hero h1{max-width:13ch}
.hero .sub{max-width:34rem;font-size:1.15rem;color:var(--mut);margin:1.5rem 0 2rem}
.note{font-size:.9rem;color:var(--mut);margin-top:1rem}
.proof{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:0}
.proof .w{display:grid;grid-template-columns:1fr 1fr;padding:0}
.proof div.c{padding:1.6rem 1.25rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
.proof div.c:nth-child(2n){border-right:0}
.proof div.c:nth-child(n+3){border-bottom:0}
.num{font-family:Fraunces,serif;font-size:clamp(2.2rem,8vw,3.4rem);line-height:1}
.proof small{display:block;margin-top:.5rem;font-size:.9rem;color:var(--mut);line-height:1.4}
.worries{list-style:none;padding:0;margin:0 0 2rem;max-width:40rem}
.worries li{font-family:Fraunces,serif;font-size:clamp(1.3rem,4.5vw,1.9rem);line-height:1.3;padding:1.1rem 0;border-top:1px solid var(--line)}
.worries li:last-child{border-bottom:1px solid var(--line)}
.lead{max-width:36rem;opacity:.9}
.step{display:grid;grid-template-columns:4.5rem 1fr;gap:1rem;padding:1.8rem 0;border-top:1px solid var(--line)}
.step .n{font-family:Fraunces,serif;font-size:3.6rem;line-height:1;color:var(--brass)}
.step h3{font-size:1.6rem;margin-bottom:.5rem}
.step p{max-width:34rem;color:var(--mut);margin:0}
.svc{display:grid;gap:.4rem;padding:1.6rem 0;border-top:1px solid var(--line)}
.svc h3{font-size:1.6rem}
.svc p{margin:0;color:var(--mut);max-width:32rem}
.cs{display:grid;gap:2rem}
.big{font-family:Fraunces,serif;font-size:clamp(5rem,26vw,10rem);line-height:.9;color:var(--brass)}
.cs p{max-width:36rem}
.ph{border:2px dashed var(--brass);padding:1.2rem;font-size:.95rem;color:var(--mut);margin-top:1rem}
blockquote{margin:1.6rem 0 0;padding-left:1rem;border-left:2px solid var(--brass);font-family:Fraunces,serif;font-size:1.25rem;line-height:1.4}blockquote cite{display:block;margin-top:.6rem;font:400 .9rem "DM Sans",sans-serif;opacity:.8}
.about{display:grid;gap:2rem}
.photo{aspect-ratio:4/5;max-width:320px;width:100%;border:2px dashed var(--brass);display:flex;align-items:center;justify-content:center;text-align:center;padding:1.5rem;color:var(--mut);font-size:.95rem}
details{border-top:1px solid var(--line);padding:1.1rem 0}
details:last-of-type{border-bottom:1px solid var(--line)}
summary{font-family:Fraunces,serif;font-size:1.35rem;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem}
a{color:inherit}
img,svg{display:block}
.w{max-width:1180px;margin:0 auto;padding:0 1.25rem}
section{padding:5rem 0}
.mark{background:linear-gradient(transparent 58%,var(--sun) 58%,var(--sun) 90%,transparent 90%);padding:0 .06em}
.tag{display:inline-flex;align-items:center;gap:.5rem;font:500 .78rem var(--mono);letter-spacing:.04em;text-transform:uppercase;color:var(--blue)}
.tag::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--sun);box-shadow:0 0 0 3px rgba(255,201,60,.3)}
.on-blue .tag{color:var(--sun)}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.6rem;background:var(--blue);color:#fff;font:600 1rem var(--body);padding:1rem 1.4rem;border:0;border-radius:999px;text-decoration:none;cursor:pointer;min-height:52px;transition:transform .2s,background .2s,box-shadow .2s;box-shadow:0 1px 0 rgba(0,0,0,.1)}
.btn svg{transition:transform .25s}
.btn:hover{background:var(--blue-d);transform:translateY(-2px);box-shadow:0 10px 24px -10px rgba(27,47,184,.6)}
.btn:hover svg{transform:translateX(3px)}
.btn:active{transform:translateY(0)}
.btn.sun{background:var(--sun);color:var(--ink)}
.btn.sun:hover{background:#ffd666;box-shadow:0 10px 24px -10px rgba(0,0,0,.4)}
.btn.ghost{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--line)}
.btn.ghost:hover{box-shadow:inset 0 0 0 1.5px var(--ink);background:transparent}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:6px}

/* header */
header{position:sticky;top:0;z-index:50;background:rgba(250,248,243,.86);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid transparent;transition:border-color .3s}
header.scrolled{border-color:var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;height:72px;gap:1rem}
.brand{display:flex;align-items:center;gap:.7rem;text-decoration:none}
.brand b{font:800 1.15rem/1 var(--display);letter-spacing:-.02em;display:block}
.brand small{font:500 .68rem/1 var(--mono);color:var(--ink-2);letter-spacing:.03em;text-transform:uppercase;display:block;margin-top:.3rem}
.links{display:none;gap:2rem;font-weight:500;font-size:.95rem}
.links a{text-decoration:none;position:relative}
.links a::after{content:"";position:absolute;left:0;right:0;bottom:-4px;height:2px;background:var(--blue);transform:scaleX(0);transform-origin:left;transition:transform .25s}
.links a:hover::after{transform:scaleX(1)}
.nav .btn{padding:.65rem 1.1rem;min-height:44px;font-size:.92rem}

/* hero */
.hero{padding:3.5rem 0 5rem;position:relative;overflow:hidden}
.hero-grid{display:grid;gap:3.5rem;align-items:center}
.hero h1{margin:1.2rem 0 1.5rem}
.hero .sub{font-size:1.2rem;color:var(--ink-2);max-width:33rem;margin-bottom:2rem}
.cta-row{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center}
.reply{display:flex;align-items:center;gap:.6rem;margin-top:1.6rem;font-size:.92rem;color:var(--ink-2)}
.dot{width:9px;height:9px;border-radius:50%;background:#22A06B;position:relative}
.dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:#22A06B;animation:ping 2s infinite}
@keyframes ping{0%{transform:scale(1);opacity:.7}80%,100%{transform:scale(2.8);opacity:0}}

/* call log card */
.stage{position:relative;padding:1.5rem 0 1.5rem 0}
.blob{position:absolute;inset:-8% -20% -8% 8%;background:var(--blue);border-radius:42% 58% 52% 48%/46% 40% 60% 54%;z-index:0}
.rings{position:absolute;right:-40px;top:-30px;z-index:0;opacity:.9}
.card{position:relative;z-index:1;background:#fff;border-radius:20px;box-shadow:0 30px 60px -25px rgba(18,31,128,.55),0 0 0 1px rgba(21,23,28,.05);padding:1.3rem;max-width:440px;margin-left:auto;transform:rotate(-1.5deg)}
.card-h{display:flex;justify-content:space-between;align-items:center;padding-bottom:1rem;border-bottom:1px solid var(--line)}
.card-h b{font:700 1rem var(--display)}
.card-h span{font:500 .7rem var(--mono);color:var(--ink-2);background:var(--paper-2);padding:.3rem .55rem;border-radius:999px}
.call{display:grid;grid-template-columns:38px 1fr auto;gap:.8rem;align-items:center;padding:.8rem 0;border-bottom:1px dashed var(--line);opacity:0;transform:translateY(8px);animation:rise .6s forwards}
.call:nth-child(2){animation-delay:.5s}.call:nth-child(3){animation-delay:.75s}.call:nth-child(4){animation-delay:1s}.call:nth-child(5){animation-delay:1.25s}
@keyframes rise{to{opacity:1;transform:none}}
.ic{width:38px;height:38px;border-radius:11px;background:var(--blue-l);display:grid;place-items:center;color:var(--blue)}
.call b{display:block;font-size:.95rem;font-weight:600;line-height:1.2}
.call small{font-size:.8rem;color:var(--ink-2)}
.call em{font:500 .75rem var(--mono);font-style:normal;color:var(--ink-2)}
.card-f{display:flex;justify-content:space-between;align-items:end;padding-top:1rem}
.card-f small{font-size:.8rem;color:var(--ink-2);display:block}
.card-f strong{font:800 2.3rem/1 var(--display);letter-spacing:-.03em}
.chip{font:600 .8rem var(--body);background:#DDF3E8;color:#13704A;padding:.35rem .65rem;border-radius:999px}
.sticker{position:absolute;z-index:2;left:-6px;bottom:-14px;background:var(--sun);color:var(--ink);font:800 1rem/1.05 var(--display);padding:1rem 1.1rem;border-radius:50%;width:118px;height:118px;display:grid;place-items:center;text-align:center;transform:rotate(-12deg);box-shadow:0 12px 24px -12px rgba(0,0,0,.4);animation:wob 6s ease-in-out infinite}
@keyframes wob{50%{transform:rotate(-6deg) translateY(-4px)}}
.example{position:relative;z-index:1;text-align:right;font:500 .68rem var(--mono);color:rgba(255,255,255,.75);margin-top:.9rem;max-width:440px;margin-left:auto}

/* ticker */
.ticker{background:var(--ink);color:var(--paper);overflow:hidden;padding:1rem 0;white-space:nowrap}
.ticker-t{display:inline-flex;gap:2.5rem;animation:tick 32s linear infinite;font:700 1.15rem var(--display);letter-spacing:-.01em}
.ticker-t span{display:inline-flex;align-items:center;gap:2.5rem}
.ticker-t span::after{content:"";width:10px;height:10px;background:var(--sun);border-radius:50%}
@keyframes tick{to{transform:translateX(-50%)}}

/* stats */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
.stat{background:var(--paper);padding:1.6rem 1.3rem}
.stat strong{font:800 clamp(2.4rem,6vw,3.6rem)/1 var(--display);letter-spacing:-.04em;color:var(--blue);display:block}
.stat span{display:block;margin-top:.6rem;font-size:.92rem;color:var(--ink-2);line-height:1.4;max-width:16rem}

/* problem */
.problem{background:var(--paper-2)}
.split{display:grid;gap:3rem}
.bubbles{display:grid;gap:1rem}
.bubble{background:#fff;border-radius:22px 22px 22px 6px;padding:1.1rem 1.3rem;font:600 1.2rem/1.35 var(--display);letter-spacing:-.01em;box-shadow:0 1px 0 var(--line);max-width:26rem;transition:transform .3s}
.bubble:nth-child(even){justify-self:end;border-radius:22px 22px 6px 22px;background:var(--ink);color:var(--paper)}
.bubble:hover{transform:translateY(-3px) rotate(-.5deg)}
.lead{font-size:1.15rem;color:var(--ink-2);max-width:32rem}

/* process */
.steps{display:grid;gap:1rem;margin-top:3rem;counter-reset:s}
.st{position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:1.6rem;transition:transform .3s,box-shadow .3s}
.st:hover{transform:translateY(-4px);box-shadow:0 20px 40px -24px rgba(21,23,28,.35)}
.st .when{font:500 .72rem var(--mono);text-transform:uppercase;letter-spacing:.05em;color:var(--blue);background:var(--blue-l);padding:.3rem .6rem;border-radius:999px;display:inline-block;margin-bottom:1.4rem}
.st h3{margin-bottom:.6rem}
.st p{color:var(--ink-2);margin:0}
.st .glyph{position:absolute;top:1.3rem;right:1.3rem;color:var(--ink)}
.st.feature{background:var(--blue);color:#fff;border-color:var(--blue)}
.st.feature p{color:rgba(255,255,255,.8)}
.st.feature .when{background:var(--sun);color:var(--ink)}
.st.feature .glyph{color:var(--sun)}

/* services */
.svc-list{margin-top:2.5rem;border-top:2px solid var(--ink)}
.svc{display:grid;gap:.5rem;padding:1.6rem 0;border-bottom:1px solid var(--line);position:relative;transition:padding .3s}
.svc .no{font:500 .8rem var(--mono);color:var(--ink-2)}
.svc h3{font-size:clamp(1.5rem,3.5vw,2.2rem)}
.svc p{margin:0;color:var(--ink-2);max-width:30rem}
.svc .arrow{display:none}

/* case */
.case{background:var(--blue);color:#fff;position:relative;overflow:hidden}
.case .grain{position:absolute;inset:0;opacity:.08;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:18px 18px;pointer-events:none}
.case-grid{display:grid;gap:3rem;position:relative}
.case h2{margin:1rem 0 1.4rem}
.case p{color:rgba(255,255,255,.85);max-width:34rem}
.chart{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:1.6rem}
.chart h4{margin:0 0 1.4rem;font:500 .78rem var(--mono);text-transform:uppercase;letter-spacing:.05em;color:rgba(255,255,255,.7)}
.bars{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;align-items:end;min-height:240px}
.bar{display:flex;flex-direction:column;justify-content:flex-end;height:100%}
.bar i{display:block;border-radius:10px 10px 4px 4px;background:rgba(255,255,255,.25);transform-origin:bottom;transform:scaleY(0);transition:transform 1.1s cubic-bezier(.2,.8,.2,1)}
.bar.after i{background:var(--sun)}
.in .bar i{transform:scaleY(1)}
.in .bar.after i{transition-delay:.25s}
.bar strong{font:800 2.4rem/1 var(--display);letter-spacing:-.03em;margin-bottom:.6rem}
.bar span{font-size:.85rem;color:rgba(255,255,255,.75);margin-top:.6rem}
.chart .foot{display:flex;justify-content:space-between;margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid rgba(255,255,255,.18);font-size:.95rem}
.chart .foot b{color:var(--sun);font:800 1.6rem/1 var(--display)}

/* work */
.work-head{display:grid;gap:1.5rem;align-items:end;margin-bottom:2.5rem}
.work-head p{color:var(--ink-2);max-width:30rem;margin:0}
.kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin-bottom:1.5rem}
.kpi{background:#fff;padding:1.2rem 1.3rem}
.kpi small{display:block;font:500 .72rem var(--mono);text-transform:uppercase;letter-spacing:.05em;color:var(--ink-2)}
.kpi strong{display:block;font:800 clamp(1.8rem,4vw,2.6rem)/1.1 var(--display);letter-spacing:-.03em;margin-top:.35rem}
.kpi.hl{background:var(--blue);color:#fff}.kpi.hl small{color:rgba(255,255,255,.75)}
.kpi.sun{background:var(--sun)}
.shots{display:grid;gap:1.25rem}
.win{margin:0;background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 30px 60px -30px rgba(21,23,28,.45),0 0 0 1px var(--line);transition:transform .35s}
.win:hover{transform:translateY(-4px)}
.win-bar{display:flex;align-items:center;gap:.4rem;padding:.7rem 1rem;background:var(--paper-2);border-bottom:1px solid var(--line)}
.win-bar i{width:10px;height:10px;border-radius:50%;background:rgba(21,23,28,.18)}
.win-bar span{margin-left:.6rem;font:500 .72rem var(--mono);color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.win a{display:block;overflow-x:auto}
.win img{width:100%;min-width:640px;height:auto}
.win figcaption{padding:.9rem 1rem;font-size:.88rem;color:var(--ink-2);border-top:1px solid var(--line)}
.win figcaption b{color:var(--ink)}
@media(min-width:720px){.kpis{grid-template-columns:repeat(5,1fr)}.win img{min-width:0}}
@media(min-width:960px){.work-head{grid-template-columns:1fr 1fr;gap:5rem}}

/* about */
.about{display:grid;gap:3rem;align-items:center}
.portrait{position:relative;max-width:380px;width:100%;aspect-ratio:4/5;border-radius:200px 200px 24px 24px;background:var(--blue);overflow:hidden;display:grid;place-items:center}
.portrait .ini{font:800 8rem/1 var(--display);color:var(--sun);letter-spacing:-.06em}
.portrait .cap{position:absolute;left:1rem;right:1rem;bottom:1rem;background:var(--paper);border-radius:12px;padding:.8rem 1rem;font-size:.85rem;display:flex;justify-content:space-between;gap:.5rem}
.portrait .cap b{font-family:var(--display)}
.creds{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.6rem}
.cred{display:inline-flex;align-items:center;gap:.5rem;border:1.5px solid var(--ink);border-radius:999px;padding:.45rem .9rem;font-weight:600;font-size:.9rem}
.cred svg{color:var(--blue)}
.about p{color:var(--ink-2);max-width:34rem}
.about p:first-of-type{color:var(--ink);font-size:1.25rem}

/* pricing strip */
.offer{background:var(--sun);border-radius:24px;padding:2rem 1.5rem;display:grid;gap:1.5rem;align-items:center;position:relative;overflow:hidden}
